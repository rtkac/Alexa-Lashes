{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@alexa-lashes/ui#watch", "@alexa-lashes/db#watch"],
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "dependsOn": ["^build"]
    },
    "//#format": {
      "dependsOn": ["^build"]
    },
    "watch": { "cache": false, "persistent": true }
  }
}
