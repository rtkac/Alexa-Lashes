{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed-file.sh",
            "timeout": 60,
            "statusMessage": "Linting..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/build-changed-package.sh",
            "timeout": 60,
            "statusMessage": "Building..."
          }
        ]
      }
    ]
  }
}
