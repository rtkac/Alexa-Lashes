{
  "name": "@alexa-lashes/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./dist/components/index.js"
    },
    "./shadcn": {
      "types": "./src/components/shadcn/index.ts",
      "default": "./dist/components/shadcn/index.js"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./dist/icons/index.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./src/components/styles.css",
    "./shadcn/styles.css": "./src/components/shadcn/styles.css"
  },
  "scripts": {
    "watch": "tsc --watch",
    "build": "tsc"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@radix-ui/react-accordion": "1.2.6",
    "clsx": "2.1.1",
    "lucide-react": "^1.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-photo-view": "^1.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
