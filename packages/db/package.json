{
  "name": "@alexa-lashes/db",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./locales": {
      "types": "./src/locales.ts",
      "default": "./dist/locales.js"
    },
    "./schema/*": {
      "types": "./src/schema/*.ts",
      "default": "./dist/schema/*.js"
    },
    "./queries/*": {
      "types": "./src/queries/*.ts",
      "default": "./dist/queries/*.js"
    }
  },
  "scripts": {
    "watch": "tsc --watch",
    "build": "tsc",
    "better-auth:generate": "bunx auth@latest generate --config=../auth/src/index.ts --output=./src/schema",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "seed:email": "bun run src/seed/allowed-email.ts",
    "seed:review": "bun run src/seed/review.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2"
  }
}
