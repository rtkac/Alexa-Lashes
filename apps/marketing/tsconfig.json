{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
